[Unit]
Description=EnderSync API
After=network.target

[Service]
Type=simple
User=endersync
Group=endersync
WorkingDirectory=/opt/endersync_vps
EnvironmentFile=/etc/endersync_vps.env
ExecStart=/usr/bin/node /opt/endersync_vps/dist/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target